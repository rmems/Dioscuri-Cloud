# Terraform
.terraform/
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Terraform vars (often contain secrets)
*.tfvars
*.tfvars.json

# Local override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc

# IDE / agent tool scratch dirs (never commit local tool state)
.cursor/*
# Cursor Cloud Agent environment: committed on purpose.
!.cursor/environment.json
!.cursor/install.sh
.kilo/
.kiro/
node_modules/
